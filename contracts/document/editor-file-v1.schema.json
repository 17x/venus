{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venus.local/contracts/document/editor-file-v1.schema.json",
  "title": "Venus editor file v1",
  "type": "object",
  "required": ["id", "name", "version", "createdAt", "updatedAt", "config", "elements"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "createdAt": {"type": "number"},
    "updatedAt": {"type": "number"},
    "config": {
      "type": "object",
      "required": ["page"],
      "properties": {
        "page": {
          "type": "object",
          "required": ["unit", "width", "height", "dpi"],
          "properties": {
            "unit": {"type": "string"},
            "width": {"type": "number", "exclusiveMinimum": 0},
            "height": {"type": "number", "exclusiveMinimum": 0},
            "dpi": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "mimeType"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "type": {"type": "string"},
          "mimeType": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
